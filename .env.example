# Copie para .env no servidor e preencha. O .env NUNCA vai para o Git.

# Imagem publicada pela pipeline no GitHub Container Registry (tudo minúsculo)
APP_IMAGE=ghcr.io/seu-usuario/projeto-devops:latest

# Domínios apontados para o IP da VPS
APP_DOMAIN=devops.seudominio.com.br
STATUS_DOMAIN=status.seudominio.com.br

# E-mail usado pelo Let's Encrypt para avisos de expiração
ACME_EMAIL=seu-email@exemplo.com
