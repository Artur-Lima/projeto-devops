# Segredos — nunca versionar
.env
*.pem
*.key
acme.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Sistema
.DS_Store

# Terraform — estado e credenciais nunca vão para o Git
.terraform/
*.tfstate
*.tfstate.*
terraform.tfvars
crash.log
# Inventário gerado pelo Terraform (contém o IP da VM criada)
ansible/inventory.terraform.ini
