# Copie para terraform.tfvars (que NÃO é versionado) e preencha.
# Os dados ficam em OCI Console -> Perfil -> API keys -> Add API key.

tenancy_ocid     = "ocid1.tenancy.oc1..xxxxxxxx"
user_ocid        = "ocid1.user.oc1..xxxxxxxx"
fingerprint      = "aa:bb:cc:..."
private_key_path = "~/.oci/oci_api_key.pem"
region           = "sa-saopaulo-1"
# compartment_ocid = "ocid1.compartment.oc1..xxxxxxxx"  # vazio = raiz do tenancy

ssh_public_key_path  = "~/.ssh/id_ed25519.pub"
ssh_private_key_path = "~/.ssh/id_ed25519"

# Always Free: VM.Standard.A1.Flex (ARM) ou VM.Standard.E2.1.Micro (AMD, 1 GB)
# Se der "Out of host capacity" no A1, troque para o E2.1.Micro.
shape      = "VM.Standard.A1.Flex"
ocpus      = 1
memoria_gb = 6

sistema        = "Oracle Linux" # ou "Canonical Ubuntu"
versao_sistema = "9"            # ou "24.04" para Ubuntu

# origem_ssh = "SEU_IP/32"      # recomendado: SSH só a partir do seu IP
